# Copy to .env and fill in. Never commit .env. Never prefix the key with VITE_.
GEMINI_API_KEY=your_google_ai_studio_key_here
GEMMA_MODEL=gemma-4-26b-a4b-it
PORT=3001
CORS_ORIGIN=http://localhost:5173
MAX_INPUT_CHARS=8000
MODEL_TIMEOUT_MS=30000
# Optional. Leave empty to omit thinkingConfig. Try: minimal | high  (decide after scripts/verify.js)
THINKING_LEVEL=
# Optional. true = send responseMimeType=application/json (only if verify.js shows Gemma 4 accepts it)
JSON_MODE=false
